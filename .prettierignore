# What prettier must not touch, because something else owns the bytes.
#
# Prettier does not read .gitignore, so everything below has to be named here
# even where git already ignores it.

# pnpm writes this, in its own style.
pnpm-lock.yaml

# Written by changesets on every release.
**/CHANGELOG.md

# Build output.
dist/
coverage/

# The signed snapshot @ghub/terms-rules carries: its signature covers these
# exact bytes, and a reformatted copy no longer verifies.
packages/terms-rules/snapshot/snapshot.json
packages/terms-rules/snapshot/snapshot.sig.json
