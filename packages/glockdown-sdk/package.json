{
  "name": "@ghub/glockdown-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "GLockdown for apps: the stage this app's GLockdown agent has set, read from the file the agent writes, and the call that raises this app one rung over pinned TLS. Hand-written on node: built-ins, no dependencies.",
  "author": "Gelhaus Solutions (Enno Gelhaus) <egelhaus@ennogelhaus.de> (https://ennogelhaus.de)",
  "homepage": "https://ennogelhaus.de",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gelhaus-Solutions/GHub-Packages.git",
    "directory": "packages/glockdown-sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE ./LICENSE",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
