{
  "name": "@ghub/ui",
  "version": "0.19.0",
  "description": "The design system of the Gelhaus Solutions product family: hand-rolled accessible React components. No Radix, no shadcn, no headless component libraries.",
  "author": "Gelhaus Solutions (Enno Gelhaus) <egelhaus@ennogelhaus.de> (https://ennogelhaus.de)",
  "homepage": "https://ennogelhaus.de",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gelhaus-Solutions/GHub-Packages.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modern": {
      "types": "./dist/modern/index.d.ts",
      "default": "./dist/modern/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./behaviour": {
      "types": "./dist/behaviour.d.ts",
      "default": "./dist/behaviour.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE ./LICENSE",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@ghub/tokens": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
